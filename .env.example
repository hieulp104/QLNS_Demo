# ═══ NA — biến môi trường ═══
# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit .env.

# --- Database ---
DATABASE_URL="postgresql://na:na_dev_password@localhost:5434/na?schema=public"

# --- Auth.js (NextAuth v5) ---
# Sinh khóa: openssl rand -base64 32
AUTH_SECRET="thay-bang-chuoi-ngau-nhien-32-byte"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# --- MinIO (file storage) ---
MINIO_ENDPOINT="localhost"
MINIO_PORT=9102
MINIO_USE_SSL=false
MINIO_ACCESS_KEY="na_dev"
MINIO_SECRET_KEY="na_dev_password"
MINIO_BUCKET="na-files"

# --- NA AI (OpenRouter Responses API) ---
# Không commit khóa thật. OPENROUTER_MODEL phải là model có hỗ trợ function calling.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""
AI_PROVIDER_TIMEOUT_MS=45000

# --- MCP: cho Claude bên ngoài (claude.ai Custom Connector / Claude Code) đọc dữ liệu ---
# Gọi POST /api/mcp kèm header "Authorization: Bearer <token>". Để trống = tắt endpoint (404).
# Sinh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" — tối thiểu 24 ký tự.
MCP_API_TOKEN=""

# --- Khác ---
TZ="Asia/Ho_Chi_Minh"

# Mật khẩu mặc định cho tài khoản seed (chỉ dùng ở môi trường dev)
SEED_DEFAULT_PASSWORD="Demo@2026"

# ═══════════════════════════════════════════════════════════════════
# CHỈ PRODUCTION — dùng với docker-compose.prod.yml (bỏ qua khi chạy dev)
# ═══════════════════════════════════════════════════════════════════
# Trên VPS, KHÔNG dùng lại giá trị dev bên trên. Sửa cụ thể:
#
#   AUTH_SECRET="<openssl rand -base64 32 — sinh chuỗi MỚI>"
#   AUTH_URL="https://abcd.io.vn"
#   AUTH_TRUST_HOST=true
#
#   # DB trỏ vào service Docker nội bộ (host = tên service `postgres`, cổng 5432).
#   # Mật khẩu ở đây PHẢI khớp POSTGRES_PASSWORD ngay dưới (env_file không tự thay biến).
#   DATABASE_URL="postgresql://na:<MAT_KHAU_DB_MANH>@postgres:5432/na?schema=public"
#
#   # MinIO công khai qua subdomain để trình duyệt dùng presigned URL.
#   MINIO_ENDPOINT="storage.abcd.io.vn"
#   MINIO_PORT=443
#   MINIO_USE_SSL=true
#   MINIO_ACCESS_KEY="na"
#   MINIO_SECRET_KEY="<MAT_KHAU_MINIO_MANH>"
#   MINIO_BUCKET="na-files"
#
#   # Bản demo: GIỮ SEED_DEFAULT_PASSWORD — mỗi lần deploy đều nạp dữ liệu demo (db:seed).

# --- Biến riêng cho docker-compose.prod.yml (compose đọc trực tiếp) ---
POSTGRES_PASSWORD="<MAT_KHAU_DB_MANH>"   # khớp mật khẩu trong DATABASE_URL
APP_DOMAIN="abcd.io.vn"
STORAGE_DOMAIN="storage.abcd.io.vn"

# --- Tài khoản Giám đốc khởi tạo (npm run seed:prod — bản demo KHÔNG dùng) ---
SEED_ADMIN_EMAIL="director@abcd.io.vn"
SEED_ADMIN_PASSWORD="<MAT_KHAU_GIAM_DOC_MANH>"
