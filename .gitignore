# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

.package-lock.json


# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...nhưng file mẫu thì PHẢI commit để người mới clone biết cần biến gì
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma Client sinh tự động — chạy `npm install` là có (xem script postinstall)
/src/generated/prisma

# file tam cua Microsoft Office khi dang mo tai lieu
~$*
