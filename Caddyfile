# NA — reverse proxy + HTTPS tự động (Let's Encrypt).
# Caddy tự xin & gia hạn chứng chỉ cho cả 2 domain miễn là:
#  · Cổng 80 + 443 mở ra internet.
#  · Cả 2 domain có bản ghi DNS A trỏ về IP của VPS.

# Chỉ dùng HTTP/1 + HTTP/2 — TẮT HTTP/3 (QUIC). HTTP/3 chạy trên UDP đôi khi bị
# chập chờn (mạng/ISP chặn UDP) gây lỗi "This page couldn't load" ngẫu nhiên trên
# trình duyệt. HTTP/2 vẫn nhanh và ổn định.
{
	servers {
		protocols h1 h2
	}
}

# App Next.js
{$APP_DOMAIN} {
	reverse_proxy app:3000
}

# MinIO API (S3) — PHẢI công khai để trình duyệt dùng presigned URL upload/xem
# file (luồng 2 pha PUT thẳng lên MinIO). Object vẫn private, chỉ mở được qua
# URL có chữ ký hết hạn 15 phút. Caddy giữ nguyên Host header → chữ ký khớp.
{$STORAGE_DOMAIN} {
	reverse_proxy minio:9000
}
